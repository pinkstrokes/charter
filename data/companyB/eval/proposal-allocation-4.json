  "program": {
    "domain": "allocation",
    "rules": [
      {
        "when": {
          "op": "feat",
          "name": "reference_paid"
        },
        "then": {
          "decide": "leave_unapplied_ask",
          "note": "payment reference names an already-paid invoice; likely a duplicate payment"
        }
      },
      {
        "when": {
          "op": "and",
          "args": [
            {
              "op": "cmp",
              "c": "gt",
              "a": {
                "op": "feat",
                "name": "solution_count"
              },
              "b": {
                "op": "num",
                "v": 1
              }
            },
            {
              "op": "not",
              "a": {
                "op": "or",
                "args": [
                  {
                    "op": "feat",
                    "name": "remittance_consistent"
                  },
                  {
                    "op": "feat",
                    "name": "reference_matches_open"
                  }
                ]
              }
            },
            {
              "op": "feat",
              "name": "reference_names_open"
            }
          ]
        },
        "then": {
          "decide": "leave_unapplied_ask",
          "note": "multiple subsets fit without payer confirmation and reference overpays open invoices; risk of misapplication"
        }
      },
      {
        "when": {
          "op": "and",
          "args": [
            {
              "op": "cmp",
              "c": "eq",
              "a": {
                "op": "feat",
                "name": "solution_count"
              },
              "b": {
                "op": "num",
                "v": 1
              }
            },
            {
              "op": "feat",
              "name": "exact_match"
            },
            {
              "op": "not",
              "a": {
                "op": "feat",
                "name": "reference_paid"
              }
            }
          ]
        },
        "then": {
          "decide": "apply_unique",
          "note": "one subset sums exactly to the receipt and reference is not already paid"
        }
      },
      {
        "when": {
          "op": "and",
          "args": [
            {
              "op": "cmp",
              "c": "eq",
              "a": {
                "op": "feat",
                "name": "solution_count"
              },
              "b": {
                "op": "num",
                "v": 1
              }
            },
            {
              "op": "feat",
              "name": "reference_names_open"
            }
          ]
        },
        "then": {
          "decide": "apply_to_reference",
          "note": "single inexact match but reference names an open invoice"
        }
      },
      {
        "when": {
          "op": "and",
          "args": [
            {
              "op": "cmp",
              "c": "gt",
              "a": {
                "op": "feat",
                "name": "solution_count"
              },
              "b": {
                "op": "num",
                "v": 1
              }
            },
            {
              "op": "or",
              "args": [
                {
                  "op": "feat",
                  "name": "remittance_consistent"
                },
                {
                  "op": "feat",
                  "name": "reference_matches_open"
                }
              ]
            }
          ]
        },
        "then": {
          "decide": "apply_unique",
          "note": "payer confirmed which invoices among several matching subsets"
        }
      },
      {
        "when": {
          "op": "cmp",
          "c": "eq",
          "a": {
            "op": "feat",
            "name": "solution_count"
          },
          "b": {
            "op": "num",
            "v": 1
          }
        },
        "then": {
          "decide": "apply_unique",
          "note": "one subset explains the amount within tolerance"
        }
      },
      {
        "when": {
          "op": "and",
          "args": [
            {
              "op": "cmp",
              "c": "eq",
              "a": {
                "op": "feat",
                "name": "solution_count"
              },
              "b": {
                "op": "num",
                "v": 0
              }
            },
            {
              "op": "feat",
              "name": "reference_names_open"
            }
          ]
        },
        "then": {
          "decide": "apply_to_reference",
          "note": "no subset matches but reference names open invoices"
        }
      },
      {
        "when": {
          "op": "cmp",
          "c": "eq",
          "a": {
            "op": "feat",
            "name": "solution_count"
          },
          "b": {
            "op": "num",
            "v": 0
          }
        },
        "then": {
          "decide": "apply_by_terms",
          "note": "no subset matches; apply by contract order"
        }
      }
    ],
    "otherwise": {
      "decide": "leave_unapplied_ask",
      "note": "several invoice sets explain this amount with no payer guidance"
    }
