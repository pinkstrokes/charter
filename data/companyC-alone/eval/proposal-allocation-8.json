    "rules": [
      {
        "when": {
          "op": "feat",
          "name": "reference_paid"
        },
        "then": {
          "decide": "leave_unapplied_ask",
          "note": "reference names an already-paid invoice; likely a duplicate payment"
        }
      },
      {
        "when": {
          "op": "and",
          "args": [
            {
              "op": "cmp",
              "c": "eq",
              "a": {
                "op": "feat",
                "name": "solution_count"
              },
              "b": {
                "op": "num",
                "v": 1
              }
            },
            {
              "op": "feat",
              "name": "exact_match"
            },
            {
              "op": "not",
              "a": {
                "op": "and",
                "args": [
                  {
                    "op": "feat",
                    "name": "reference_names_open"
                  },
                  {
                    "op": "cmp",
                    "c": "gt",
                    "a": {
                      "op": "feat",
                      "name": "open_items"
                    },
                    "b": {
                      "op": "num",
                      "v": 2
                    }
                  }
                ]
              }
            }
          ]
        },
        "then": {
          "decide": "apply_unique"
        }
      },
      {
        "when": {
          "op": "and",
          "args": [
            {
              "op": "cmp",
              "c": "eq",
              "a": {
                "op": "feat",
                "name": "solution_count"
              },
              "b": {
                "op": "num",
                "v": 1
              }
            },
            {
              "op": "feat",
              "name": "reference_names_open"
            }
          ]
        },
        "then": {
          "decide": "apply_to_reference",
          "note": "one subset within tolerance but reference names an open invoice; trust the payer's reference"
        }
      },
      {
        "when": {
          "op": "and",
          "args": [
            {
              "op": "cmp",
              "c": "ge",
              "a": {
                "op": "feat",
                "name": "solution_count"
              },
              "b": {
                "op": "num",
                "v": 2
              }
            },
            {
              "op": "feat",
              "name": "exact_match"
            },
            {
              "op": "feat",
              "name": "remittance_present"
            },
            {
              "op": "feat",
              "name": "remittance_consistent"
            }
          ]
        },
        "then": {
          "decide": "apply_unique",
          "note": "multiple subsets fit but remittance is present and consistent; trust the payer's list"
        }
      },
      {
        "when": {
          "op": "cmp",
          "c": "eq",
          "a": {
            "op": "feat",
            "name": "solution_count"
          },
          "b": {
            "op": "num",
            "v": 1
          }
        },
        "then": {
          "decide": "apply_unique",
          "note": "one subset explains the amount within tolerance"
        }
      },
      {
        "when": {
          "op": "and",
          "args": [
            {
              "op": "cmp",
              "c": "eq",
              "a": {
                "op": "feat",
                "name": "solution_count"
              },
              "b": {
                "op": "num",
                "v": 0
              }
            },
            {
              "op": "feat",
              "name": "reference_names_open"
            },
            {
              "op": "cmp",
              "c": "gt",
              "a": {
                "op": "feat",
                "name": "open_items"
              },
              "b": {
                "op": "num",
                "v": 2
              }
            }
          ]
        },
        "then": {
          "decide": "apply_to_reference",
          "note": "no subset matches but reference names an open invoice among many; trust the payer's reference over blind terms order"
        }
      },
      {
        "when": {
          "op": "and",
          "args": [
            {
              "op": "cmp",
              "c": "eq",
              "a": {
                "op": "feat",
                "name": "solution_count"
              },
              "b": {
                "op": "num",
                "v": 0
              }
            },
            {
              "op": "feat",
              "name": "reference_names_open"
            },
            {
              "op": "cmp",
              "c": "le",
              "a": {
                "op": "feat",
                "name": "reference_gap_cents"
              },
              "b": {
                "op": "num",
                "v": 0
              }
            }
          ]
        },
        "then": {
          "decide": "apply_to_reference",
          "note": "no subset matches but reference names an open invoice and payment covers it"
        }
      },
      {
        "when": {
          "op": "cmp",
          "c": "eq",
          "a": {
            "op": "feat",
            "name": "solution_count"
          },
          "b": {
            "op": "num",
            "v": 0
